{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "pool": "forks"
  },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": ["src/utils/*.js", "!src/utils/variables.js", "!src/utils/setenv*.js"],
  "ignorePatterns": ["target", "temp", "validation*", "reports", "src/utils/setenv*.js", "src/.env"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 95
  }
}
