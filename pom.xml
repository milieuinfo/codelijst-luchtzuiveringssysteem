<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>be.milieuinfo</groupId>
    <artifactId>acd-parent</artifactId>
    <version>1.0.9</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <packaging>jar</packaging>
  <groupId>be.vlaanderen.omgeving.data.id.graph</groupId>
  <artifactId>codelijst-luchtzuiveringssysteem</artifactId>
  <version>0.2.3-SNAPSHOT</version>
  <name>codelijst-luchtzuiveringssysteem</name>
  <description />
  <scm>
    <connection>scm:git:https://github.com/milieuinfo/codelijst-luchtzuiveringssysteem.git</connection>
    <developerConnection>scm:git:https://github.com/milieuinfo/codelijst-luchtzuiveringssysteem.git</developerConnection>
    <url>https://github.com/milieuinfo/codelijst-luchtzuiveringssysteem.git</url>
    <tag>HEAD</tag>
  </scm>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>2.2.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>attach-sources-override</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>2.6</version>
        <configuration>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>2.0.2</version>
        <configuration>
          <nodeVersion>v26.10.0</nodeVersion>
          <pnpmVersion>9.15.9</pnpmVersion>
          <nodeDownloadRoot>${acd.repository.node.dist.url}</nodeDownloadRoot>
          <pnpmDownloadRoot>${acd.repository.pnpm.dist.url}</pnpmDownloadRoot>
          <serverId>repo.omgeving.vlaanderen.be</serverId>
          <installDirectory>target/</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install node and pnpm</id>
            <goals>
              <goal>install-node-and-pnpm</goal>
            </goals>
          </execution>
          <execution>
            <id>pnpm install</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <arguments>install --frozen-lockfile</arguments>
            </configuration>
          </execution>
          <execution>
            <!-- genereert de SKOS-bestanden opnieuw uit src/source; Jenkins controleert
                 daarna dat ze identiek zijn aan de gecommitte versie. Zonder changelog
                 (create_skos werkt lokaal ook CHANGELOG.md bij; daarvoor zijn git-tags nodig) -->
            <id>create skos</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <arguments>run create_skos_only</arguments>
            </configuration>
          </execution>
          <execution>
            <id>create metadata</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <arguments>run create_metadata</arguments>
            </configuration>
          </execution>
          <execution>
            <!-- niet aan een fase gekoppeld: enkel expliciet aangeroepen door Jenkins via
                 'frontend:pnpm@code-quality' (ESLint + Prettier-controle) -->
            <id>code-quality</id>
            <phase>none</phase>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <arguments>run check</arguments>
            </configuration>
          </execution>
          <execution>
            <!-- niet aan een fase gekoppeld: enkel expliciet aangeroepen door Jenkins via
                 'frontend:pnpm@validate-previous-release', zodat node in de Maven-container draait -->
            <id>validate-previous-release</id>
            <phase>none</phase>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <arguments>run validate:release</arguments>
            </configuration>
          </execution>
          <execution>
            <!-- niet aan een fase gekoppeld: enkel bij een release aangeroepen door Jenkins via
                 'frontend:pnpm@create-changelog'; de nieuwe versie komt uit de omgevingsvariabele VERSION -->
            <id>create-changelog</id>
            <phase>none</phase>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <arguments>run create_changelog_full</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
        </excludes>
      </resource>
      <resource>
        <directory>temp</directory>
        <filtering>false</filtering>
        <excludes>
        </excludes>
      </resource>
    </resources>
  </build>
</project>
