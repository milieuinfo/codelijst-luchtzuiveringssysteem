{
  "name": "codelijst-luchtzuiveringssysteem",
  "version": "1.0.0",
  "private": true,
  "description": "SKOS-codelijst van luchtzuiveringssystemen in stallen (ARMOS): CSV naar RDF, gevalideerd met SHACL",
  "keywords": [
    "milieuinfo",
    "linked data",
    "skos",
    "rdfjs",
    "dcat",
    "maven"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milieuinfo/codelijst-luchtzuiveringssysteem.git"
  },
  "license": "CC0-1.0",
  "author": "Vlaamse Overheid, Departement omgeving",
  "type": "module",
  "scripts": {
    "check": "pnpm run lint && pnpm run format:check && pnpm run test",
    "create_changelog": "cd src && node 04_create_changelog.js",
    "create_changelog_full": "cd src && node 04_create_changelog.js --full",
    "create_metadata": "cd src && node 02_metadata.js",
    "create_skos": "pnpm run create_skos_only && pnpm run create_changelog",
    "create_skos_only": "cd src && node 01_codelijst_skos_from_csv.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "validate:history": "cd src && node 03_validate_against_previous_release.js --history",
    "validate:release": "cd src && node 03_validate_against_previous_release.js"
  },
  "dependencies": {
    "@milieuinfo/maven-metadata-generator-npm": "0.7.8",
    "@zazuko/env-node": "1.0.2",
    "dotenv": "16.6.1",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@vitest/coverage-v8": "5.1.0",
    "csv-parser": "3.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-package-json": "1.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8",
  "engines": {
    "node": ">=26.10.0"
  }
}
